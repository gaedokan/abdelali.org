// Cloudflare Workers config. Cloudflare builds and deploys this on every push to `main`.
{
  "name": "abdelali-site",
  "compatibility_date": "2026-11-01",
  // Only /budget/api/* runs this code (sync + iPhone Wallet endpoint). Everything else is static.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/budget/api/*"]
  },
  // Budget sync database. Fill in the name and id of your existing D1 database
  // (Cloudflare dashboard → Storage & Databases → D1), then uncomment.
  // The worker creates its own tables (budget_items) on first use and touches nothing else.
  // "d1_databases": [
  //   { "binding": "BUDGET_DB", "database_name": "YOUR_DB_NAME", "database_id": "YOUR_DB_ID" }
  // ],
  "vars": { "BUDGET_TIMEZONE": "Africa/Casablanca" },
  // Private while in review: no public *.workers.dev address and no preview links.
  // The site only becomes public once a custom domain (abdelali.org) is attached.
  "workers_dev": false,
  "preview_urls": false
}
